{
  "name": "dsh-obsidian-sync-v2",
  "version": "2.0.0",
  "description": "DSH Obsidian Sync V2 — 按需搜索 Obsidian 知识库 + 按 vault 既有 PARA 规则归档 DSH 会话（Cordis 插件，零系统提示词注入、进程内 fs、倒排索引、幂等 upsert）",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis-plugin",
    "obsidian",
    "knowledge-base",
    "sync",
    "para"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.20.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "Dingpenghui-good",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dingpenghui-good/dsh-obsidian-sync-v2.git"
  }
}
