{
  "name": "dsh-obsidian-sync",
  "version": "2.0.2",
  "description": "DSH Obsidian Sync - DSH Cordis plugin: on-demand Obsidian knowledge-base search + DSH session archiving following your vault's existing PARA rules (zero token injection, in-process fs, inverted index, idempotent upsert)",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-fs": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.20.2",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dsh",
    "obsidian",
    "knowledge-base",
    "plugin",
    "sync",
    "cordis",
    "para"
  ],
  "author": "Dingpenghui-good",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dingpenghui-good/dsh-obsidian-sync.git"
  }
}
